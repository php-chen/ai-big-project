# ============================================================
# 全局基座环境变量模板（方向一：所有微服务共用同一套命名规范）
# 复制为 .env 后按需修改；新增变量必须先更新本文档
# 命名规范：全小写下划线，<类型>_URL 表示连接串
# ============================================================

# ---- 运行环境 ----
APP_ENV=development                 # development | staging | production
APP_NAME=ai-big-project
SERVICE_NAME=service-template       # 每个服务唯一
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# ---- 数据源（读写分离）----
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REPLICA_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://guest:guest@localhost:5672/

# ---- 可观测性（定律5：OpenTelemetry 标准）----
OTEL_EXPORTER_OTLP_ENDPOINT=        # 留空=关闭导出；例如 http://localhost:4318
OTEL_SERVICE_NAME=

# ---- 日志（定律5）----
LOG_JSON=true
LOG_ACCESS=true
LOG_SLOW_QUERY_MS=0            # >0 开启慢查询日志（毫秒阈值）

# ---- 安全（定律3：信任边界）----
# 生产必须 TRUST_PROXY_HEADERS=true，且网关与服务间启用 mTLS/服务网格。
# 业务服务只信任网关注入的身份头（X-User-Id / X-User-Roles / X-Tenant-Id）
TRUST_PROXY_HEADERS=false
JWT_ISSUER=
JWT_AUDIENCE=
DEV_TOKEN=dev-token                 # 仅开发环境网关使用

# ---- 幂等（定律4）----
IDEMPOTENCY_TTL_SECONDS=3600

# ---- 网关 ----
UPSTREAM_SERVICE_URL=http://localhost:8100