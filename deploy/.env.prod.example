# 生产环境变量模板（复制为 .env.prod 并填写真实值；禁止提交真实密钥）
# 使用：docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d

POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=app
POSTGRES_REPLICATION_USER=repl
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_REPL

RABBITMQ_USER=guest
RABBITMQ_PASS=CHANGE_ME

# 网关鉴权（生产应接入真实 JWT，DEV_TOKEN 仅用于开发/预演）
DEV_TOKEN=dev-token

LOG_LEVEL=INFO

# 镜像仓库与标签（CD 时由流水线注入 TAG）
REGISTRY=ghcr.io/yourorg
TAG=latest

# 负载均衡入口端口
NGINX_PORT=80
NGINX_HTTPS_PORT=443